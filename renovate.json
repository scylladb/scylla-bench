{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "commitBodyTable": true,
  "schedule": [
    "every weekend"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "helm-values"
  ],
  "packageRules": [
    {
      "description": "Group all Go module dependencies except the CQL drivers",
      "groupName": "All dependencies",
      "groupSlug": "all-dependencies",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "!github.com/scylladb/gocql",
        "!github.com/gocql/gocql"
      ],
      "enabled": true
    },
    {
      "description": "Keep scylladb/gocql updates separate for manual review",
      "matchPackageNames": [
        "github.com/scylladb/gocql"
      ],
      "enabled": true
    },
    {
      "description": "scylladb/gocql is a fork pinned via a replace directive; major bumps track the upstream apache driver and are never drop-in. Bump manually.",
      "matchPackageNames": [
        "github.com/scylladb/gocql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "github.com/gocql/gocql is fully replaced by scylladb/gocql; its version is inert, so never open PRs for it (notably the apache v2 major).",
      "matchPackageNames": [
        "github.com/gocql/gocql"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "renovate",
      "dependencies",
      "P1"
    ],
    "schedule": [
      "at any time"
    ]
  },
  "osvVulnerabilityAlerts": true
}